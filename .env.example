# ================================================
# DAILY SHLOKA SYSTEM — Environment Variables
# Copy this file to .env and fill in your values
# ================================================

# --- Server ---
PORT=3000
NODE_ENV=production
BASE_URL=https://your-app.railway.app

# --- Gmail SMTP ---
# Steps: Gmail → Settings → Security → App Passwords → Generate
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM_NAME=Daily Shloka 🪷

# --- Razorpay ---
# Get from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# --- Google Gemini AI ---
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Admin Panel ---
ADMIN_PASSWORD=change-this-to-strong-password
ADMIN_SECRET_KEY=some-random-secret-key-for-tokens

# --- Subscription Pricing (in paise, 1 INR = 100 paise) ---
PRICE_TRIAL_DAYS=7
PRICE_MONTHLY=4900
PRICE_YEARLY=39900

# --- App Settings ---
APP_NAME=Daily Shloka
TIMEZONE=Asia/Kolkata
